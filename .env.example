# ---------------------------------------------------------------------------
# Variables de entorno (readme, secciones 1.4 y 2.4). Copia este archivo a .env
# y cambia las contraseñas. Sin $, # ni comillas en los valores: make lee .env y
# los interpreta distinto que el shell. Los espacios sí valen (HOGAR_NOMBRE): make,
# docker compose y scripts/migrate.sh, que lo lee línea por línea, toman el valor completo.
# ---------------------------------------------------------------------------

# PostgreSQL: superusuario, solo para la inicialización del contenedor db
POSTGRES_DB=hogar
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambia-esto

# Dueño de las tablas: solo para migraciones, la carga del mock y los tests
DB_OWNER_PASSWORD=cambia-esto-owner
# true en desarrollo y CI (pytest crea la base de tests); false en producción
DB_OWNER_CREATEDB=true

# Usuario de la aplicación en tiempo de ejecución
DB_APP_PASSWORD=cambia-esto-app

# Django (readme, sección 2.5)
# Genera la tuya, solo con letras y números, con:
# docker run --rm python:3.12-slim python -c "import secrets, string; print(''.join(secrets.choice(string.ascii_letters + string.digits) for _ in range(64)))"
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
# config.settings.local en desarrollo; config.settings.prod en el servidor del hogar y el VPS
DJANGO_SETTINGS_MODULE=config.settings.local
# Orígenes desde los que Django acepta formularios (HTTPS de nginx). En el VPS: https://<dominio>
CSRF_TRUSTED_ORIGINS=https://localhost

# Nombre del Hogar: lo usa la migración entidades/0003_hogar al crear el Hogar (HB-06), una
# sola vez (máximo 150 caracteres). Obligatoria en producción: config.settings.prod no arranca
# sin ella, y lleva el nombre real del hogar (o el de la demo, si es la demo). En desarrollo
# basta el valor por defecto de settings ("Hogar Gerontológico Demo"); docker-compose.yml no
# inventa ninguno.
HOGAR_NOMBRE=Hogar Gerontológico Demo

# Imagen de web: true instala pytest, ruff y djLint (desarrollo); false en producción
INSTALAR_DEV=true
# Opcional en desarrollo: --reload reinicia Gunicorn al guardar un .py
GUNICORN_CMD_ARGS=--reload
